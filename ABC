local function executeCommand(text)
	if not text then return end
	local cleaned = text:match("^%s*(.-)%s*$")
	if cleaned == "" then return end
	local parts = {}
	for token in cleaned:gmatch("%S+") do table.insert(parts, token) end
	local name = parts[1]:gsub("^/", ""):lower()
	local args = {}
	for i = 2, #parts do args[i - 1] = parts[i] end
	local cmd = commands[name]
	if not cmd then
		setStatus("Unknown command: " .. name)
		pushLog("X /" .. name, false)
		return
	end
	local ok, result = pcall(cmd.fn, args)
	if not ok then
		setStatus("Error: " .. tostring(result))
		pushLog("X /" .. name .. " " .. tostring(result), false)
	else
		if type(result) == "string" then setStatus(result) end
		pushLog("OK /" .. name, true)
	end
	refreshQuickToggles()
	refreshStatChips()
end

