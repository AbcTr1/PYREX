-- categories for command filtering
local function setFrom(list)
	local t = {}
	for word in list:gmatch("%S+") do t[word] = true end
	return t
end
local catSets = {
	Movement = setFrom("fly unfly flyspeed speed jump hipheight gravity noclip clip infinitejump noinfinitejump autojump stopautojump autowalk stopwalk spin spinspeed levitate unlevitate highjump lowspeed normalspeed normaljump resetgravity savepos loadpos"),
	Player = setFrom("goto bring tbring respawn kick sit stand zombie unzombie heal healall godall ungodall invisibleall visibleall noclipall clipall"),
	Combat = setFrom("kill killall damage burn unburn freeze unfreeze freezeall unfreezeall fling flingall aimbot noaimbot aimlock noaimlock silentaim nosilentaim"),
	Visual = setFrom("esp noesp nameesp nonameesp tracer notracer espcolor xray fullbright nofullbright crosshair nocrosshair blind unblind invisible visible god ungod forcefield noforcefield thirdperson firstperson camzoom fov time fog bright ambient clicktp noclicktp clickdelete noclickdelete deletepart deleteall"),
	System = setFrom("cmds help clear remove rejoin resetall"),
}
local function categoryOf(name)
	for _, cat in ipairs({"Movement", "Player", "Combat", "Visual", "System"}) do
		if catSets[cat][name] then return cat end
	end
	return "System"
end

