local minimizeGen = 0
local function minimizeToBubble()
	minimizeGen = minimizeGen + 1
	local gen = minimizeGen
	local vx, vy = cam().ViewportSize.X, cam().ViewportSize.Y
	local px = main.Position.X.Scale * vx + main.Position.X.Offset + 500 - 32
	local py = main.Position.Y.Scale * vy + main.Position.Y.Offset + 320 - 32
	bubble.Position = UDim2.new(0, math.clamp(px, 0, math.max(0, vx - 64)), 0, math.clamp(py, 0, math.max(0, vy - 64)))
	main.Size = mainBase
	main.BackgroundTransparency = 0
	uiTween(main, {Size = UDim2.new(0, 940, 0, 600), BackgroundTransparency = 0.35}, 0.12, Enum.EasingStyle.Quart, Enum.EasingDirection.Out, 1, true)
	bubble.Visible = true
	bubble.Size = bubbleBase
	uiTween(bubble, {Size = UDim2.new(0, 50, 0, 50)}, 0.14, Enum.EasingStyle.Back, Enum.EasingDirection.Out, 1, true)
	task.delay(0.24, function()
		if minimized and gen == minimizeGen then main.Visible = false end
	end)
	minimized = true
	minBtn.Text = "+"
end
local function restoreFromBubble()
	minimizeGen = minimizeGen + 1
	local vx, vy = cam().ViewportSize.X, cam().ViewportSize.Y
	local px = bubble.Position.X.Scale * vx + bubble.Position.X.Offset + 32 - 500
	local py = bubble.Position.Y.Scale * vy + bubble.Position.Y.Offset + 32 - 320
	main.Position = UDim2.new(0, math.clamp(px, 0, math.max(0, vx - 1000)), 0, math.clamp(py, 0, math.max(0, vy - 640)))
	main.Visible = true
	main.Size = UDim2.new(0, 950, 0, 608)
	main.BackgroundTransparency = 0.3
	uiTween(main, {Size = mainBase, BackgroundTransparency = 0}, 0.24, Enum.EasingStyle.Back)
	bubble.Visible = false
	minimized = false
	minBtn.Text = "-"
end
