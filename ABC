local function setFullbright(on)
	state.fullbright = on
	if on then
		state.originals.brightness = state.originals.brightness or Lighting.Brightness
		state.originals.ambient = state.originals.ambient or Lighting.Ambient
		Lighting.Brightness = 2
		Lighting.Ambient = Color3.new(1, 1, 1)
		Lighting.Outlines = false
	else
		Lighting.Brightness = state.originals.brightness or 1
		Lighting.Ambient = state.originals.ambient or Color3.new(0.5, 0.5, 0.5)
		if state.originals.outlines ~= nil then Lighting.Outlines = state.originals.outlines end
	end
end

local function setFrozen(p, on)
	local h, r = getHum(p), getRoot(p)
	if not h or not r then return end
	if on then
		if not state.frozen[p] then
			state.frozen[p] = {
				char = p.Character,
				walk = h.WalkSpeed,
				jump = h.JumpPower,
				height = h.JumpHeight,
				useJumpPower = h.UseJumpPower,
				anchored = r.Anchored,
			}
			h.WalkSpeed = 0
			h.JumpPower = 0
			h.JumpHeight = 0
			r.Anchored = true
		end
	else
		local orig = state.frozen[p]
		if orig and orig.char == p.Character then
			h.WalkSpeed = orig.walk
			h.JumpPower = orig.jump
			h.JumpHeight = orig.height
			h.UseJumpPower = orig.useJumpPower
			r.Anchored = orig.anchored
			state.frozen[p] = nil
		elseif orig then
			state.frozen[p] = nil
		end
	end
end

local function clearFrozen()
	local list = {}
	for p in pairs(state.frozen) do table.insert(list, p) end
	for _, p in ipairs(list) do setFrozen(p, false) end
end

local function toggleForcefield(on)
	state.forcefield = on
	refreshChar()
	if not root then return end
	if on then
		if not root:FindFirstChildOfClass("ForceField") then
			Instance.new("ForceField", root).Visible = true
		end
	else
		local ff = root:FindFirstChildOfClass("ForceField")
		if ff then pcall(function() ff:Destroy() end) end
	end
end

