local function corner(parent, radius)
	local c = Instance.new("UICorner", parent)
	c.CornerRadius = UDim.new(0, radius or 10)
	return c
end

local function outline(parent, transparency)
	local s = Instance.new("UIStroke", parent)
	s.Color = Color3.new(1, 1, 1)
	s.Transparency = transparency or 0.9
	s.Thickness = 1
	return s
end

local function hexColor(hex)
	return Color3.fromRGB(
		tonumber(hex:sub(1, 2), 16),
		tonumber(hex:sub(3, 4), 16),
		tonumber(hex:sub(5, 6), 16)
	)
end

local function gradient(parent, c1, c2)
	local g = Instance.new("UIGradient", parent)
	g.Color = ColorSequence.new(c1, c2)
	return g
end

local function label(parent, text, size, pos, textSize, color, font)
	local l = Instance.new("TextLabel", parent)
	l.Size = size
	l.Position = pos
	l.BackgroundTransparency = 1
	l.Text = text
	l.TextColor3 = color or Color3.new(1, 1, 1)
	l.TextSize = textSize or 14
	l.Font = font or Enum.Font.Gotham
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.TextTruncate = Enum.TextTruncate.AtEnd
	return l
end

local activeTweens = {}
local function uiTween(obj, props, dur, style, dir, repeats, reverses)
	local map = activeTweens[obj]
	if not map then map = {}; activeTweens[obj] = map end
	for prop in pairs(props) do
		local old = map[prop]
		if old then pcall(function() old:Cancel() end); map[prop] = nil end
	end
	local ok, tw = pcall(function()
		return TS:Create(obj, TweenInfo.new(
			dur or 0.16,
			style or Enum.EasingStyle.Quart,
			dir or Enum.EasingDirection.Out,
			repeats or 0,
			reverses == true,
			0
		), props)
	end)
	if ok and tw then
		for prop in pairs(props) do map[prop] = tw end
		connect(tw.Completed, function()
			for prop in pairs(props) do
				if map[prop] == tw then map[prop] = nil end
			end
		end)
		tw:Play()
	end
	return tw
end

local function tapSize(btn, base)
	local small = UDim2.new(0, math.max(14, base.X.Offset - 5), 0, math.max(14, base.Y.Offset - 4))
	btn.Size = base
	uiTween(btn, {Size = small}, 0.1, Enum.EasingStyle.Quart, Enum.EasingDirection.Out, 1, true)
end

local function tapColor(btn)
	local c = btn.BackgroundColor3
	local hi = Color3.new(math.min(1, c.R + 0.16), math.min(1, c.G + 0.16), math.min(1, c.B + 0.16))
	uiTween(btn, {BackgroundColor3 = hi}, 0.1, Enum.EasingStyle.Quart, Enum.EasingDirection.Out, 1, true)
end

local function hoverSize(btn, normal, raised, bucket)
	local enter = connect(btn.MouseEnter, function()
		uiTween(btn, {Size = raised}, 0.14, Enum.EasingStyle.Back)
	end)
	local leave = connect(btn.MouseLeave, function()
		uiTween(btn, {Size = normal}, 0.14, Enum.EasingStyle.Quart)
	end)
	if bucket then
		table.insert(bucket, enter)
		table.insert(bucket, leave)
	end
end

