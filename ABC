	local currentCamera = cam()
	if state.aimbot and UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
		local p = nearestPlayer()
		local r = p and getRoot(p)
		if r then currentCamera.CFrame = CFrame.lookAt(currentCamera.CFrame.Position, r.Position) end
