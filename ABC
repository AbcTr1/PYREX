local function refreshServerInfo()
	refreshChar()
	local playerList = Players:GetPlayers()
	if serverValues.place then serverValues.place.Text = tostring(game.PlaceId) end
	if serverValues.job then
		local job = game.JobId
		serverValues.job.Text = job ~= "" and job:sub(1, 18) or "Private"
	end
	if serverValues.players then
		local maxPlayers = Players.MaxPlayers
		serverValues.players.Text = maxPlayers and maxPlayers > 0 and (#playerList .. " / " .. maxPlayers) or tostring(#playerList)
	end
	if serverValues.ping then
		local ok, ping = pcall(function() return LocalPlayer:GetNetworkPing() end)
		serverValues.ping.Text = ok and (math.floor(ping * 1000) .. " ms") or "n/a"
	end
	if serverValues.uptime then
		local t = math.floor(os.clock() - sessionStart)
		serverValues.uptime.Text = string.format("%02d:%02d:%02d", math.floor(t / 3600), math.floor(t / 60) % 60, t % 60)
	end
	if serverValues.name then serverValues.name.Text = LocalPlayer.Name end
	if serverValues.userid then serverValues.userid.Text = tostring(LocalPlayer.UserId) end
	if serverValues.health then serverValues.health.Text = humanoid and (math.floor(humanoid.Health) .. " / " .. math.floor(humanoid.MaxHealth)) or "-" end
	if serverValues.speed then serverValues.speed.Text = humanoid and tostring(math.floor(humanoid.WalkSpeed)) or "-" end
	if serverValues.jump then serverValues.jump.Text = humanoid and tostring(math.floor(humanoid.UseJumpPower and humanoid.JumpPower or humanoid.JumpHeight)) or "-" end
	if serverValues.position then
		serverValues.position.Text = root and string.format("%.0f, %.0f, %.0f", root.Position.X, root.Position.Y, root.Position.Z) or "-"
	end
	for i = 1, 5 do
		local p = playerList[i]
		if p then
			local ok, ping = pcall(function() return p:GetNetworkPing() end)
			rosterLabels[i].Text = p.Name .. "  ·  " .. (ok and (math.floor(ping * 1000) .. " ms") or "n/a")
