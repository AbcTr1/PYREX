local dragging = false
local dragTarget, dragStart, startPos
local function beginDrag(inp, target)
	if dragging then return end
	dragging = true
	dragTarget = target
	dragStart = inp.Position
	startPos = target.Position
	bubbleDragMoved = false
end
local function stopDrag()
	dragging = false
	dragTarget = nil
end
connect(top.InputBegan, function(inp)
	if inp.Target and inp.Target:IsA("GuiButton") then return end
	if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
		beginDrag(inp, main)
	end
end)
connect(bubble.InputBegan, function(inp)
	if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
		beginDrag(inp, bubble)
	end
end)
connect(UIS.InputChanged, function(inp)
	if not dragging then return end
	if inp.UserInputType ~= Enum.UserInputType.MouseMovement and inp.UserInputType ~= Enum.UserInputType.Touch then return end
	local delta = inp.Position - dragStart
	bubbleDragMoved = bubbleDragMoved or delta.Magnitude > 3
	local vx, vy = cam().ViewportSize.X, cam().ViewportSize.Y
	if dragTarget == bubble then
		local size = bubble.AbsoluteSize.X > 0 and bubble.AbsoluteSize.X or 64
		bubble.Position = UDim2.new(0, math.clamp(startPos.X.Offset + delta.X, 0, math.max(0, vx - size)), 0, math.clamp(startPos.Y.Offset + delta.Y, 0, math.max(0, vy - size)))
	else
		local px = startPos.X.Scale * vx + startPos.X.Offset + delta.X
		local py = startPos.Y.Scale * vy + startPos.Y.Offset + delta.Y
		main.Position = UDim2.new(0, math.clamp(px, 0, math.max(0, vx - mainBase.X.Offset)), 0, math.clamp(py, 0, math.max(0, vy - mainBase.Y.Offset)))
	end
end)
connect(UIS.InputEnded, function(inp)
	if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
		if inp.UserInputState == Enum.UserInputState.End or inp.UserInputState == Enum.UserInputState.Cancel then
			stopDrag()
		end
	end
end)

