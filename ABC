		local c = p.Character
		if c then
			for _, part in ipairs(c:GetDescendants()) do
				if part:IsA("BasePart") and orig[part] then part.CanCollide = orig[part] end
			end
		end
	end
	state.noclipAll = {}
	workspace.Gravity = state.originals.gravity or 196.2
