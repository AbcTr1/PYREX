local function filterCommands()
	filterPending = false
	for _, conn in ipairs(commandButtonConnections) do pcall(function() conn:Disconnect() end) end
	commandButtonConnections = {}
	for _, child in ipairs(scroll:GetChildren()) do
		if child:IsA("TextButton") then child:Destroy() end
	end
	local terms = {}
	for term in searchBox.Text:lower():gmatch("%S+") do table.insert(terms, term) end
	local shown = {}
	for _, entry in ipairs(commandOrder) do
		local cat = categoryOf(entry.name)
		local catOk = activeCategory == "All" or activeCategory == cat
		local hay = entry.name:lower() .. " " .. tostring(entry.desc):lower()
		local searchOk = #terms == 0
		if not searchOk then
			searchOk = true
			for _, term in ipairs(terms) do
				if not hay:find(term, 1, true) then searchOk = false; break end
			end
		end
		if catOk and searchOk then table.insert(shown, entry) end
	end
	for i, entry in ipairs(shown) do
		local col = (i - 1) % 3
		local row = math.floor((i - 1) / 3)
		local b = Instance.new("TextButton", scroll)
		b.Size = UDim2.new(0, 225, 0, 42)
		b.Position = UDim2.new(0, 10 + col * 235, 0, 10 + row * 50)
		b.Text = "/" .. entry.name .. " — " .. entry.desc
		b.TextXAlignment = Enum.TextXAlignment.Left
		b.BackgroundColor3 = Color3.fromRGB(35, 35, 46)
		b.TextColor3 = Color3.new(0.9, 0.9, 0.95)
		b.TextSize = 12
		b.Font = Enum.Font.Gotham
		b.BorderSizePixel = 0
		corner(b, 10)
		local baseSize = b.Size
		hoverSize(b, baseSize, UDim2.new(0, 231, 0, 44), commandButtonConnections)
		local clickConn = connect(b.MouseButton1Click, function()
			tapSize(b, baseSize)
			tapColor(b)
			input.Text = "/" .. entry.name
			input:CaptureFocus()
		end)
		table.insert(commandButtonConnections, clickConn)
	end
	local rows = math.ceil(#shown / 3)
	scroll.CanvasSize = UDim2.new(0, 0, 0, math.max(10 + rows * 50, 60))
	scroll.CanvasPosition = Vector2.new(0, 0)
end

