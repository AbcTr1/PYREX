local function getColor(name)
	return colors[string.lower(name or "green")] or colors.green
end

local function getPlayer(arg, allowSelf)
	if allowSelf == false and (not arg or arg == "" or arg == "me") then return nil end
	if not arg or arg == "" or arg == "me" then return LocalPlayer end
	local lower = string.lower(arg)
	for _, p in ipairs(Players:GetPlayers()) do
		if string.lower(p.Name) == lower then return p end
	end
	for _, p in ipairs(Players:GetPlayers()) do
		if string.sub(string.lower(p.Name), 1, #lower) == lower then return p end
	end
	return nil
end

local function getRoot(p)
	if not p or not p.Character then return nil end
	return p.Character:FindFirstChild("HumanoidRootPart")
end

local function getHum(p)
	if not p or not p.Character then return nil end
	return p.Character:FindFirstChildOfClass("Humanoid")
end

local function isOwnCharacter(part)
	local own = LocalPlayer and LocalPlayer.Character
	return own ~= nil and part ~= nil and part:IsDescendantOf(own)
end

local function validNum(value, fallback, minValue, maxValue)
	local n = tonumber(value)
	if not n or n ~= n or n == math.huge or n == -math.huge then n = fallback end
	if minValue and n < minValue then n = minValue end
	if maxValue and n > maxValue then n = maxValue end
	return n
end

local function nearestPlayer()
	local best, bestDist = nil, math.huge
	local camPos = cam().CFrame.Position
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer then
			local r = getRoot(p)
			if r then
				local d = (r.Position - camPos).Magnitude
				if d < bestDist then bestDist, best = d, p end
			end
		end
	end
	return best
end

local function zeroRootVelocity()
	if not root then return end
	pcall(function()
		if root.AssemblyLinearVelocity then
			root.AssemblyLinearVelocity = Vector3.zero
		else
			root.Velocity = Vector3.zero
		end
	end)
end

local silentMouse = nil
pcall(function() silentMouse = LocalPlayer:GetMouse() end)
local function silentAimRedirect()
	local s = G.HUB_STATE
	if not s or not s.silentAim then return nil end
	local p = nearestPlayer()
	local ch = p and p.Character
	if not ch then return nil end
	return ch:FindFirstChild("HumanoidRootPart") or ch:FindFirstChildWhichIsA("BasePart")
end
if type(hookfunction) == "function" and silentMouse and not G.PYREX_SILENT_HOOK_READY then
	pcall(function()
		local original = silentMouse.GetTarget
		if type(original) ~= "function" then return end
		hookfunction(original, function(...)
			local redirected = silentAimRedirect()
			if redirected then return redirected end
			return original(...)
		end)
		G.PYREX_SILENT_HOOK_READY = true
	end)
end
state.silentHookReady = G.PYREX_SILENT_HOOK_READY == true

local function clearFlyBody()
	refreshChar()
	if root then
		for _, obj in ipairs(root:GetChildren()) do
			if obj.Name == "PYREX_FLY" or obj.Name == "PYREX_FLY_GYRO" or obj.Name == "PYREX_FLY_ATT" then
				pcall(function() obj:Destroy() end)
			end
		end
	end
	if state.flyBV then pcall(function() state.flyBV:Destroy() end) end
	if state.flyGyro then pcall(function() state.flyGyro:Destroy() end) end
	state.flyBV = nil
	state.flyGyro = nil
end

local function clearLevBody()
	refreshChar()
	if root then
		for _, obj in ipairs(root:GetChildren()) do
			if obj.Name == "PYREX_LEVITATE" or obj.Name == "PYREX_LEVITATE_ATT" then
				pcall(function() obj:Destroy() end)
			end
		end
	elseif state.levBV then
		pcall(function() state.levBV:Destroy() end)
	end
	state.levBV = nil
end

local function setFlyStatesEnabled(enabled)
	refreshChar()
	if not humanoid then return end
	pcall(function()
		humanoid:SetStateEnabled(Enum.HumanoidStateType.Falling, enabled)
		humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, enabled)
	end)
end

local function flyBody()
	refreshChar()
	if not root then return nil, nil end
	local bv = state.flyBV
	if not bv or not bv:IsA("BodyVelocity") or bv.Parent ~= root then
		if bv then pcall(function() bv:Destroy() end) end
		bv = Instance.new("BodyVelocity")
		bv.Name = "PYREX_FLY"
		pcall(function()
			bv.MaxForce = Vector3.new(1e6, 1e6, 1e6)
			bv.Velocity = Vector3.new(0, 0, 0)
		end)
		bv.Parent = root
		state.flyBV = bv
	end

	local gyro = state.flyGyro
	if not gyro or not gyro:IsA("BodyGyro") or gyro.Parent ~= root then
		if gyro then pcall(function() gyro:Destroy() end) end
		gyro = Instance.new("BodyGyro")
		gyro.Name = "PYREX_FLY_GYRO"
		pcall(function()
			gyro.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
			gyro.P = 8000
			gyro.D = 500
			gyro.CFrame = root.CFrame
		end)
		gyro.Parent = root
		state.flyGyro = gyro
	end
	return bv, gyro
end

local function setFly(on)
	state.fly = on
	refreshChar()
	if on then
		if not root or not humanoid then
			state.fly = false
			setStatus("No character")
			return false
		end
		if state.levitate then
			state.levitate = false
			clearLevBody()
		end
		clearFlyBody()
		local bv, gyro = flyBody()
		if not bv or not gyro then
			state.fly = false
			clearFlyBody()
			setStatus("No character")
			return false
		end
		pcall(function()
			humanoid.PlatformStand = true
			gyro.CFrame = root.CFrame
		end)
	else
		clearFlyBody()
		if humanoid then pcall(function() humanoid.PlatformStand = false end) end
		setFlyStatesEnabled(true)
	end
	return true
end

local function levBody()
	refreshChar()
	if not root then return nil end
	local lv = state.levBV
	if not lv or not lv:IsA("LinearVelocity") or lv.Parent ~= root then
		clearLevBody()
		local att = root:FindFirstChild("PYREX_LEVITATE_ATT")
		if not att or not att:IsA("Attachment") then
			if att then pcall(function() att:Destroy() end) end
			att = Instance.new("Attachment")
			att.Name = "PYREX_LEVITATE_ATT"
			att.Parent = root
		end
		lv = Instance.new("LinearVelocity")
		lv.Name = "PYREX_LEVITATE"
		pcall(function()
			lv.Attachment0 = att
			if Enum.ActuatorRelativeTo then lv.RelativeTo = Enum.ActuatorRelativeTo.World end
			lv.Velocity = Vector3.new(0, 60, 0)
			lv.MaxForce = Vector3.new(1e6, 1e6, 1e6)
		end)
		lv.Parent = root
		state.levBV = lv
	end
	return lv
end

local function setLevitate(on)
	state.levitate = on
	refreshChar()
	if on then
		if not root or not humanoid then
			state.levitate = false
			setStatus("No character")
			return false
		end
		if state.fly then
			state.fly = false
			clearFlyBody()
			setFlyStatesEnabled(true)
		end
		local bv = levBody()
		if not bv then
			state.levitate = false
			setStatus("No character")
			return false
		end
		pcall(function() bv.Velocity = Vector3.new(0, 60, 0) end)
	else
		clearLevBody()
	end
	return true
end

local function setNoclip(on)
