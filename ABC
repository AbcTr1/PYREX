connect(UIS.InputBegan, function(input, gpe)
	if gpe then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		local currentCamera = cam()
		if state.clickTp or state.clickDelete then
			local ray = currentCamera:ScreenPointToRay(input.Position.X, input.Position.Y)
			local params = RaycastParams.new()
			params.FilterType = Enum.RaycastFilterType.RejectList
			params.FilterDescendantsInstances = { LocalPlayer.Character }
			local hit = workspace:Raycast(ray.Origin, ray.Direction * 500, params)
			if hit then
				if state.clickTp and root then
					root.CFrame = CFrame.new(hit.Position + Vector3.new(0, 3, 0))
				end
				if state.clickDelete then
					pcall(function() hit.Instance:Destroy() end)
				end
			end
		end
	end
end)

