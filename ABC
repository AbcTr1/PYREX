connect(RS.Heartbeat, function(dt)
	dt = validNum(dt, 1 / 60, 0, 0.1)
	local currentChar = LocalPlayer.Character
	if state.fly then
		refreshChar()
		local bv, gyro = flyBody()
		if bv and gyro and root and root.Parent then
			local cf = cam().CFrame
			local dir = Vector3.new(0, 0, 0)
			if UIS:IsKeyDown(Enum.KeyCode.W) then dir = dir + cf.LookVector end
			if UIS:IsKeyDown(Enum.KeyCode.S) then dir = dir - cf.LookVector end
			if UIS:IsKeyDown(Enum.KeyCode.A) then dir = dir - cf.RightVector end
			if UIS:IsKeyDown(Enum.KeyCode.D) then dir = dir + cf.RightVector end
			if UIS:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0, 1, 0) end
			if UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.Q) then dir = dir - Vector3.new(0, 1, 0) end
			if dir.Magnitude > 0 then dir = dir.Unit end
			local speed = validNum(state.flySpeed, 60, 10, 300)
			if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then speed = speed * 3 end
			local target = dir * speed
			local alpha = 1 - math.exp(-dt * 14)
			pcall(function()
				bv.Velocity = bv.Velocity:Lerp(target, alpha)
				gyro.CFrame = cf
			end)
		end
	end
	if state.levitate then
		local bv = levBody()
		if bv then pcall(function() bv.Velocity = Vector3.new(0, 60, 0) end) end
	end
	if state.noclip and currentChar then
		for _, part in ipairs(currentChar:GetDescendants()) do
			if part:IsA("BasePart") then
				if state.savedCollide and state.savedCollide[part] == nil then
					state.savedCollide[part] = part.CanCollide
				end
				part.CanCollide = false
			end
		end
	end
	if state.god and humanoid and humanoid.Health < humanoid.MaxHealth then
		humanoid.Health = humanoid.MaxHealth
	end
	if state.godAllActive then
		for p in pairs(state.godAll) do
			local h = getHum(p)
			if h and h.Health < h.MaxHealth then h.Health = h.MaxHealth end
		end
	end
	if state.spin and root then
		root.CFrame = root.CFrame * CFrame.Angles(0, math.rad(validNum(state.spinSpeed, 5, -360, 360)) * dt, 0)
	end
	if state.autoJump and humanoid then
		local t = os.clock()
		if t - (state.lastAutoJump or 0) > 0.4 then
			state.lastAutoJump = t
			humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
		end
	end
	if state.autoWalk and humanoid then
		humanoid:Move(cam().CFrame.LookVector, false)
	end
	if next(state.burning) then
		local t = os.clock()
		if t - (state.lastBurn or 0) > 0.5 then
			state.lastBurn = t
			for p in pairs(state.burning) do
				local h = getHum(p)
				if h then h:TakeDamage(5) end
			end
		end
	end
	for p in pairs(state.zombies) do
		local h, r = getHum(p), getRoot(p)
		local target = getRoot(LocalPlayer)
		if h and r and target then
			local delta = target.Position - r.Position
			if delta.Magnitude > 0.001 then h:Move(delta.Unit, false) end
		end
	end
end)

