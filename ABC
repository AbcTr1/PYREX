	state.espFolder = Instance.new("Folder", playerGui)
	state.espFolder.Name = "VisualObjects"
end

local function ensureFolder()
	if not state.espFolder or not state.espFolder.Parent then
		state.espFolder = Instance.new("Folder", playerGui)
		state.espFolder.Name = "VisualObjects"
	end
end

local function clearESP()
	for _, obj in pairs(state.espObjects) do
		if obj.Parent then obj:Destroy() end
	end
	state.espObjects = {}
end

local function refreshESP()
	clearESP()
	if not state.esp then return end
	ensureFolder()
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer and p.Character then
			local hl = Instance.new("Highlight")
			hl.Adornee = p.Character
			hl.FillColor = state.espColor
			hl.FillTransparency = 0.6
			hl.OutlineColor = state.espColor
			hl.OutlineTransparency = 0
			hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			hl.Parent = state.espFolder
			table.insert(state.espObjects, hl)
		end
	end
end

local function clearNameESP()
	for _, obj in pairs(state.nameObjects) do
		if obj.Parent then obj:Destroy() end
	end
	state.nameObjects = {}
end

local function refreshNameESP()
	clearNameESP()
	if not state.nameEsp then return end
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer and p.Character then
			local head = p.Character:FindFirstChild("Head")
			if head then
				local bg = Instance.new("BillboardGui")
				bg.Name = "NameTag"
				bg.Adornee = head
				bg.Size = UDim2.new(0, 220, 0, 34)
				bg.StudsOffset = Vector3.new(0, 2.2, 0)
				bg.AlwaysOnTop = true
				local label = Instance.new("TextLabel", bg)
				label.Size = UDim2.new(1, 0, 1, 0)
				label.Text = p.Name
				label.TextColor3 = state.espColor
				label.BackgroundTransparency = 1
				label.TextScaled = true
				label.Font = Enum.Font.Code
				bg.Parent = head
				table.insert(state.nameObjects, bg)
			end
		end
	end
end

local function clearTracers()
	for _, obj in pairs(state.tracerObjects) do
		if obj.Parent then obj:Destroy() end
	end
	state.tracerObjects = {}
end

local function refreshTracers()
	clearTracers()
	if not state.tracer or not root then return end
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer then
			local r = getRoot(p)
			if r then
				local a0 = Instance.new("Attachment", root)
				local a1 = Instance.new("Attachment", r)
				local beam = Instance.new("Beam", root)
				beam.Attachment0 = a0
				beam.Attachment1 = a1
				beam.Color = ColorSequence.new(state.espColor)
				beam.Width0 = 2
				beam.Width1 = 2
				beam.FaceCamera = true
				table.insert(state.tracerObjects, a0)
				table.insert(state.tracerObjects, a1)
				table.insert(state.tracerObjects, beam)
			end
		end
	end
end

local function applyPlayerWideStates()
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer then
			if state.godAllActive then
				local h = getHum(p)
				if h then
					if not state.godAll[p] then state.godAll[p] = h.MaxHealth end
					h.MaxHealth = 100000
					h.Health = 100000
				end
			end
			if state.invisAllActive and p.Character and not state.invisAll[p] then
				local orig = {}
				for _, part in ipairs(p.Character:GetDescendants()) do
					if part:IsA("BasePart") then
						orig[part] = part.Transparency
						part.Transparency = 1
					end
				end
				state.invisAll[p] = orig
			end
			if state.noclipAllActive and p.Character and not state.noclipAll[p] then
				local orig = {}
				for _, part in ipairs(p.Character:GetDescendants()) do
					if part:IsA("BasePart") then
						orig[part] = part.CanCollide
						part.CanCollide = false
					end
				end
				state.noclipAll[p] = orig
			end
		end
	end
end

local function applyStates()
	refreshChar()
	clearFrozen()
	state.frozen = {}
	if state.forcefield then toggleForcefield(true) end
	if state.fly then setFly(false); setFly(true) end
	if state.levitate then setLevitate(false); setLevitate(true) end
	if state.noclip then setNoclip(false); setNoclip(true) end
	if state.god then setGod(false); setGod(true) end
	if state.invisible then setInvisible(false); setInvisible(true) end
	applyPlayerWideStates()
	refreshESP()
	refreshNameESP()
	refreshTracers()
end

connect(LocalPlayer.CharacterAdded, function(character)
	task.spawn(function()
		pcall(function()
			character:WaitForChild("HumanoidRootPart", 5)
			character:WaitForChild("Humanoid", 5)
		end)
		refreshChar()
		applyStates()
	end)
end)

local watchedPlayers = {}
local function watchPlayer(p)
	if not p or p == LocalPlayer or watchedPlayers[p] then return end
	watchedPlayers[p] = true
	connect(p.CharacterAdded, function()
		state.frozen[p] = nil
		state.invisAll[p] = nil
		state.noclipAll[p] = nil
		state.godAll[p] = nil
		applyPlayerWideStates()
		if state.esp then refreshESP() end
		if state.nameEsp then refreshNameESP() end
		if state.tracer then refreshTracers() end
	end)
end

connect(Players.PlayerAdded, function(p)
	watchPlayer(p)
	if state.esp then refreshESP() end
	if state.nameEsp then refreshNameESP() end
	if state.tracer then refreshTracers() end
