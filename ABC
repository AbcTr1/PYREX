local function captureOriginals()
	if humanoid then
		state.originals.walkSpeed = state.originals.walkSpeed or humanoid.WalkSpeed
		state.originals.jumpPower = state.originals.jumpPower or humanoid.JumpPower
		state.originals.jumpHeight = state.originals.jumpHeight or humanoid.JumpHeight
		if state.originals.useJumpPower == nil then state.originals.useJumpPower = humanoid.UseJumpPower end
		state.originals.hipHeight = state.originals.hipHeight or humanoid.HipHeight
		state.originals.maxHealth = state.originals.maxHealth or humanoid.MaxHealth
	end
	state.originals.gravity = state.originals.gravity or workspace.Gravity
	state.originals.brightness = state.originals.brightness or Lighting.Brightness
	state.originals.ambient = state.originals.ambient or Lighting.Ambient
	state.originals.fogEnd = state.originals.fogEnd or Lighting.FogEnd
	state.originals.fogStart = state.originals.fogStart or Lighting.FogStart
	state.originals.clockTime = state.originals.clockTime or Lighting.ClockTime
	if state.originals.outlines == nil then state.originals.outlines = Lighting.Outlines end
	state.originals.cameraFov = state.originals.cameraFov or cam().FieldOfView
	state.originals.camMin = state.originals.camMin or LocalPlayer.CameraMinZoomDistance
	state.originals.camMax = state.originals.camMax or LocalPlayer.CameraMaxZoomDistance
end

